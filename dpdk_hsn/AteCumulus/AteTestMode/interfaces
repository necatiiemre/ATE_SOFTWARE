# ============================================================================
# HSN ATE Mode - Cumulus /etc/network/interfaces  (FIZIKSEL + VLAN KATMANI)
# ----------------------------------------------------------------------------
# Server 12x100G -> swp13..swp24 (P0->swp13 ... P11->swp24), trunk
# Cihaz 4x100G   -> swp1..swp4 (D0..D3), 26x10G -> swp25s0..swp31s1 (E0..E25)
# Cihaz swp: bridge-vids {ingress 100+idx} + bridge-pvid {200+idx} (capraz-es loopback)
# Server swp: tasidigi TX+RX VLAN'lari (tagged) + park pvid. Tum portlar MTU 9216 (jumbo).
# NOT: breakout (swp25-31=4x10G) /etc/cumulus/ports.conf'ta da tanimli olmali.
# ============================================================================

source /etc/network/interfaces.d/*.intf

auto lo
iface lo inet loopback

auto mgmt
iface mgmt
    address 127.0.0.1/8
    address ::1/128
    vrf-table auto

auto eth0
iface eth0
    address 10.1.33.3/24
    gateway 10.1.33.1
    ip-forward off
    ip6-forward off
    vrf mgmt

# ===== CIHAZ 100G (swp1-4 = D0-D3) =====
auto swp1
iface swp1
    bridge-vids 100
    bridge-pvid 200
    mtu 9216
    ip6-forward off
    disable-ipv6 yes
    link-speed 100000
    link-autoneg off

auto swp2
iface swp2
